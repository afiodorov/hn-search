# Secrets for the staging stack (docker-compose.staging.yml). Copy to
# .env.staging, which is gitignored.
#
# The GitHub OAuth credentials are deliberately NOT here: they belong to the
# shared edge in ../staging-infra/.env.

DEEPSEEK_API_KEY=sk-...

# The Rust vector-search service. Staging reuses the production instance
# (read token only — never the admin token here).
HN_SEARCH_URL=https://167.233.115.172.sslip.io
HN_SEARCH_TOKEN=...

# REDIS_URL is set by the compose file; don't override it here.
